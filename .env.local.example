# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Supabase project settings: Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Free key from developer.ticketmaster.com — server-only, never exposed to the browser.
TICKETMASTER_API_KEY=your-ticketmaster-key
